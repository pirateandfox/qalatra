{
  "expo": {
    "name": "Qalatra",
    "slug": "qalatra",
    "version": "0.2.0",
    "orientation": "default",
    "scheme": "qalatra",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.qalatra.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.qalatra.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0d0e18"
      }
    },
    "plugins": [
      "expo-asset",
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Attach photos and screenshots to your tasks."
        }
      ],
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0d0e18"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "aada33e2-e5c5-4cf8-9ad1-c0ca22ccb0d4"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/aada33e2-e5c5-4cf8-9ad1-c0ca22ccb0d4"
    }
  }
}
