{
  "expo": {
    "name": "Qalatra",
    "slug": "qalatra",
    "version": "0.1.0",
    "orientation": "default",
    "scheme": "qalatra",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.qalatra.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.qalatra.app"
    },
    "plugins": [
      "expo-asset",
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Attach photos and screenshots to your tasks."
        }
      ],
      "expo-sharing"
    ],
    "extra": {
      "eas": {
        "projectId": "aada33e2-e5c5-4cf8-9ad1-c0ca22ccb0d4"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/aada33e2-e5c5-4cf8-9ad1-c0ca22ccb0d4"
    }
  }
}
