{
  "name": "Pipeline",
  "description": "Per-repo pipeline for qalatra \u2014 FlightDesk-driven review loops, merge/deploy.",
  "context": "coderepos",
  "project": "qalatra",
  "command": "claude --dangerously-skip-permissions",
  "timeout_minutes": 45,
  "coding": true,
  "env": {
    "CLAUDE_MCP_FLIGHTDESK_AUTHORIZATION": "Bearer ${FLIGHTDESK_API_KEY}"
  }
}
